# Salin ke Environment Variables di Vercel. Jangan pernah commit nilai aslinya.

# Ringkasan AI (Claude). Kosongkan untuk memakai ringkasan sederhana tanpa AI.
ANTHROPIC_API_KEY=

# Transkripsi rekaman (Whisper OpenAI atau layanan kompatibel seperti Groq).
TRANSCRIBE_API_KEY=
# Opsional. Contoh Groq: https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_API_URL=
# Opsional. Contoh: whisper-1 (OpenAI) atau whisper-large-v3-turbo (Groq)
TRANSCRIBE_MODEL=
